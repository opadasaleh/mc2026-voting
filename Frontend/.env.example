# Copy to .env.local and adjust.

# Laravel API base URL, as the visitor's phone reaches it (no trailing slash).
# On a LAN test, use the computer's IP, e.g. http://192.168.0.146:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public address of this site, encoded in the TV's "Scan to vote" QR code. Optional: defaults
# to the address the TV opened. Set it when the TV uses localhost, e.g. http://192.168.1.25:3000
# NEXT_PUBLIC_SITE_URL=https://vote.example.org

# Event opened by the bare domain (each event's QR code links to /<slug> directly).
NEXT_PUBLIC_DEFAULT_EVENT=mc2026

# TV live results: "sse" (default, production) or "poll" (every 3 s). Use "poll" when the
# API runs on `php artisan serve` (one request at a time on Windows), or a TV stream blocks voting.
NEXT_PUBLIC_RESULTS_TRANSPORT=sse
